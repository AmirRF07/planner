@echo off
chcp 65001 > nul
title سامانه برنامه‌ریزی تاریخ ایران
echo ======================================================================
echo    سامانه هوشمند برنامه‌ریزی تحصیلات تکمیلی تاریخ ایران دوره اسلامی
echo ======================================================================
echo.
echo در حال راه‌اندازی سرور محلی و باز کردن مرورگر...
echo.

python --version >nul 2>&1
if %errorlevel% equ 0 (
    python "%~dp0serve.py"
) else (
    echo پایتون پیدا نشد؛ باز کردن مستقیم فایل index.html در مرورگر پیش‌فرض...
    start "" "%~dp0index.html"
)
pause
